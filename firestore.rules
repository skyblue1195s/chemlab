rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.uid == userId &&
        data.email is string && data.email.size() <= 120 &&
        data.xp is number && data.xp >= 0 &&
        data.level is number && data.level >= 1 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
        (!('completedQuests' in data) || (data.completedQuests is list && data.completedQuests.size() <= 100)) &&
        (!('claimedDailyQuests' in data) || (data.claimedDailyQuests is list && data.claimedDailyQuests.size() <= 100));
    }

    // Validation for UserStudyNote
    function isValidUserStudyNote(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.content is string && data.content.size() <= 5000 &&
        (!('topic' in data) || (data.topic is string && data.topic.size() <= 50));
    }

    // /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email;
      allow delete: if isOwner(userId) && isValidId(userId);

      // /users/{userId}/notes/{noteId}
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && isValidUserStudyNote(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && isValidUserStudyNote(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }
    }
  }
}
